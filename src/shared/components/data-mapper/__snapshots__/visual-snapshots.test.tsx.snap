// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Visual Snapshots — DriftBanner > breaking drift with affected mappings 1`] = `"<div class="dm-drift-banner dm-drift-banner--breaking" role="alert" aria-live="polite"><div class="dm-drift-banner-icon">⛔</div><div class="dm-drift-banner-content"><div class="dm-drift-banner-title">Source schema has breaking changes</div><div class="dm-drift-banner-detail">1 removed<span class="dm-drift-banner-affected"> — 2 mappings affected</span></div><div class="dm-drift-banner-items"><div class="dm-drift-item dm-drift-item--breaking"><span class="dm-drift-item-icon">✕</span><span class="dm-drift-item-text">Field "status" was removed — 2 mappings will break.</span></div></div></div><div class="dm-drift-banner-actions"><button class="dm-drift-btn dm-drift-btn--accept" title="Accept changes and update the saved schema snapshot">Accept &amp; Update</button><button class="dm-drift-btn dm-drift-btn--dismiss" aria-label="Dismiss drift notification" title="Dismiss this notification">×</button></div></div>"`;

exports[`Visual Snapshots — DriftBanner > warning-level drift 1`] = `"<div class="dm-drift-banner dm-drift-banner--warning" role="alert" aria-live="polite"><div class="dm-drift-banner-icon">⚠</div><div class="dm-drift-banner-content"><div class="dm-drift-banner-title">Source schema changed since last mapping</div><div class="dm-drift-banner-detail">1 added</div></div><div class="dm-drift-banner-actions"><button class="dm-drift-btn dm-drift-btn--accept" title="Accept changes and update the saved schema snapshot">Accept &amp; Update</button><button class="dm-drift-btn dm-drift-btn--dismiss" aria-label="Dismiss drift notification" title="Dismiss this notification">×</button></div></div>"`;

exports[`Visual Snapshots — ErrorPopover > renders with all fields 1`] = `"<div class="dm-error-popover" style="top: 120px;" role="dialog" aria-label="Error details"><button class="dm-error-popover-close" aria-label="Close error details">×</button><div class="dm-error-popover-title">Mapping Error</div><div class="dm-error-popover-row"><span class="dm-error-popover-label">Source:</span><code class="dm-error-popover-value">$.user.name</code></div><div class="dm-error-popover-row"><span class="dm-error-popover-label">Target:</span><code class="dm-error-popover-value">$.output.name</code></div><div class="dm-error-popover-row"><span class="dm-error-popover-label">Expression:</span><code class="dm-error-popover-value">$toUpper($.user.name)</code></div><div class="dm-error-popover-row"><span class="dm-error-popover-label">Source value:</span><code class="dm-error-popover-value">"alice"</code></div><div class="dm-error-popover-row"><span class="dm-error-popover-label">Target value:</span><code class="dm-error-popover-value dm-error-popover-value--error">undefined</code></div><div class="dm-error-popover-error">Function $toUpper is not defined</div></div>"`;

exports[`Visual Snapshots — ErrorPopover > renders without expression 1`] = `"<div class="dm-error-popover" style="top: 50px;" role="dialog" aria-label="Error details"><button class="dm-error-popover-close" aria-label="Close error details">×</button><div class="dm-error-popover-title">Mapping Error</div><div class="dm-error-popover-row"><span class="dm-error-popover-label">Source:</span><code class="dm-error-popover-value">$.name</code></div><div class="dm-error-popover-row"><span class="dm-error-popover-label">Target:</span><code class="dm-error-popover-value">$.output</code></div><div class="dm-error-popover-row"><span class="dm-error-popover-label">Source value:</span><code class="dm-error-popover-value">"test"</code></div><div class="dm-error-popover-row"><span class="dm-error-popover-label">Target value:</span><code class="dm-error-popover-value ">"test"</code></div></div>"`;

exports[`Visual Snapshots — MapperToolbar > default state 1`] = `"<div class="dm-toolbar"><div class="dm-toolbar-left"><button class="dm-toolbar-btn dm-toolbar-btn--primary" title="Auto-map matching fields">⚡ Auto-map<span class="dm-toolbar-badge">5</span></button><button class="dm-toolbar-btn" title="Clear all mappings">✕ Clear all</button></div><div class="dm-toolbar-center"><span class="dm-toolbar-status">3 mappings</span></div><div class="dm-toolbar-right"><button class="dm-toolbar-btn" title="Undo (⌘Z)">↩ Undo</button><button class="dm-toolbar-btn" disabled="" title="Redo (⌘⇧Z)">↪ Redo</button></div></div>"`;

exports[`Visual Snapshots — MapperToolbar > with pending mappings and accept/reject 1`] = `"<div class="dm-toolbar"><div class="dm-toolbar-left"><button class="dm-toolbar-btn dm-toolbar-btn--primary" title="Auto-map matching fields">⚡ Auto-map</button><button class="dm-toolbar-btn" title="Clear all mappings">✕ Clear all</button><button class="dm-toolbar-btn dm-toolbar-btn--accept" title="Accept all pending auto-maps">✓ Accept all</button><button class="dm-toolbar-btn dm-toolbar-btn--reject" title="Reject all pending auto-maps">✗ Reject all</button></div><div class="dm-toolbar-center"><span class="dm-toolbar-status">3 mappings</span></div><div class="dm-toolbar-right"><button class="dm-toolbar-btn" disabled="" title="Undo (⌘Z)">↩ Undo</button><button class="dm-toolbar-btn" title="Redo (⌘⇧Z)">↪ Redo</button></div></div>"`;

exports[`Visual Snapshots — MappingCompare > renders comparison results 1`] = `"<div class="dm-compare" data-testid="mapping-compare"><div class="dm-compare-summary"><span class="dm-compare-total">2 mappings compared</span><span class="dm-compare-badge dm-compare-badge--changed">1 changed</span><span class="dm-compare-badge dm-compare-badge--unchanged">1 unchanged</span></div><div class="dm-compare-filters" role="group" aria-label="Filter comparison"><button class="dm-compare-filter-btn dm-compare-filter-btn--active">All (2)</button><button class="dm-compare-filter-btn " disabled="">Regressions (0)</button><button class="dm-compare-filter-btn ">Changes (1)</button><button class="dm-compare-filter-btn " disabled="">Fixed (0)</button></div><div class="dm-compare-table-wrap"><table class="dm-compare-table"><thead><tr><th class="dm-compare-th-status"></th><th class="dm-compare-th-path">Mapping</th><th class="dm-compare-th-value">Baseline</th><th class="dm-compare-th-value">Current</th></tr></thead><tbody><tr class="dm-compare-row dm-compare-row--changed" data-testid="compare-row-m1"><td class="dm-compare-cell-status"><span class="dm-compare-status-icon dm-compare-status-icon--changed" title="Changed">~</span></td><td class="dm-compare-cell-path"><span class="dm-compare-source">name</span><span class="dm-compare-arrow">→</span><span class="dm-compare-target">output.name</span></td><td class="dm-compare-cell-value " title="Alice"><code>Alice</code></td><td class="dm-compare-cell-value " title="Bob"><code>Bob</code></td></tr><tr class="dm-compare-row dm-compare-row--unchanged" data-testid="compare-row-m2"><td class="dm-compare-cell-status"><span class="dm-compare-status-icon dm-compare-status-icon--unchanged" title="Unchanged">=</span></td><td class="dm-compare-cell-path"><span class="dm-compare-source">age</span><span class="dm-compare-arrow">→</span><span class="dm-compare-target">output.age</span></td><td class="dm-compare-cell-value " title="25"><code>25</code></td><td class="dm-compare-cell-value " title="25"><code>25</code></td></tr></tbody></table></div></div>"`;

