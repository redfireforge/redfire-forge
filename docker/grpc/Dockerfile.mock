FROM golang:1.22-alpine AS builder

RUN apk add --no-cache protobuf-dev protoc

WORKDIR /src

COPY proto/*.proto ./proto/
COPY go-mock-server/go.mod go-mock-server/go.sum* ./go-mock-server/

WORKDIR /src/go-mock-server

RUN go mod download

RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.35.2 && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.5.1

ENV PATH="/go/bin:${PATH}"

RUN mkdir -p echo /tmp/descriptors && \
    protoc --proto_path=/src/proto \
      --go_out=echo --go_opt=paths=source_relative \
      --go-grpc_out=echo --go-grpc_opt=paths=source_relative \
      /src/proto/echo.proto && \
    protoc --proto_path=/src/proto \
      --descriptor_set_out=/tmp/descriptors/echo.protoset \
      --include_imports \
      /src/proto/echo.proto

COPY go-mock-server/main.go ./

RUN go mod tidy

RUN CGO_ENABLED=0 go build -o /grpc-go-mock-servicer .

FROM alpine:3.20

RUN apk add --no-cache ca-certificates wget

WORKDIR /app

COPY --from=builder /grpc-go-mock-servicer /app/grpc-go-mock-servicer
COPY --from=builder /tmp/descriptors/echo.protoset /app/config/echo.protoset
COPY go-mock-server/config/rules.json /app/config/rules.json

ENV MOCK_GRPC_PORT=50061
ENV MOCK_HEALTH_PORT=50062
ENV MOCK_RULE_SET_FILE=/app/config/rules.json
ENV MOCK_DESCRIPTOR_SET_FILE=/app/config/echo.protoset
ENV MOCK_DESCRIPTOR_SERVICE=echo.EchoService

EXPOSE 50061 50062

CMD ["/app/grpc-go-mock-servicer"]
