# Example local environment variables for secure Kafka profile (SASL/SCRAM)
# Copy to docker/kafka/env/secure.env for local overrides when needed.

REDPANDA_SECURE_KAFKA_PORT=19093
REDPANDA_SECURE_PANDAPROXY_PORT=18083
REDPANDA_SECURE_ADMIN_PORT=19645

# SASL credentials (admin superuser)
KAFKA_SECURE_ADMIN_USERNAME=admin
KAFKA_SECURE_ADMIN_PASSWORD=admin-secret

# SASL credentials (application user — SCRAM-SHA-256)
KAFKA_SECURE_USERNAME=redfireforge-app
KAFKA_SECURE_PASSWORD=app-password

# Smoke test settings
KAFKA_SECURE_BROKERS=127.0.0.1:19093
KAFKA_SMOKE_BASE_URL=http://127.0.0.1:3001
