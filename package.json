{
  "name": "redfire-forge",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "bin": {
    "redfireforge": "dist-cli/redfireforge.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "build:cli-package": "./scripts/build-cli-package.sh",
    "build:server": "node scripts/build-server.mjs",
    "server": "tsx src-server/index.ts",
    "server:dev": "tsx watch src-server/index.ts",
    "cli": "tsx cli/index.ts",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:mcp": "tauri dev -- --features mcp-bridge",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:graphql:clean": "bash ./scripts/run-graphql-e2e-clean.sh",
    "test:e2e:graphql:clean:headed": "bash ./scripts/run-graphql-e2e-clean.sh --headed",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:docker": "E2E_WITH_DOCKER=1 playwright test --project=docker",
    "test:e2e:docker:headed": "E2E_WITH_DOCKER=1 playwright test --project=docker --headed",
    "test:e2e:demo": "playwright test --project=demo-stepthrough --reporter=html",
    "test:e2e:demo:gql1": "playwright test --project=demo-gql1 e2e/demo-gql-first-query.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql2": "playwright test --project=demo-gql2 e2e/demo-gql-variables.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql3": "playwright test --project=demo-gql3 e2e/demo-gql-schema-exploration.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql4": "playwright test --project=demo-gql4 e2e/demo-gql-auth-headers.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql5": "playwright test --project=demo-gql5 e2e/demo-gql-https-tls.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql5:ci": "playwright test --project=demo-gql5 e2e/demo-gql-https-tls.spec.ts --reporter=list --workers=1 --timeout=900000",
    "test:e2e:demo:gql6": "playwright test --project=demo-gql6 e2e/demo-gql-mutations.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql7": "playwright test --project=demo-gql7 e2e/demo-gql-subscriptions.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql8": "playwright test --project=demo-gql8 e2e/demo-gql-query-builder.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql9": "playwright test --project=demo-gql9 e2e/demo-gql-collections-history.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql10": "playwright test --project=demo-gql10 e2e/demo-gql-export-share.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql11": "playwright test --project=demo-gql11 e2e/demo-gql-performance-tracing.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql12": "playwright test --project=demo-gql12 e2e/demo-gql-schema-diff.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql13": "playwright test --project=demo-gql13 e2e/demo-gql-mock-server.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql14": "playwright test --project=demo-gql14 e2e/demo-gql-multi-tab.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql15": "playwright test --project=demo-gql15 e2e/demo-gql-batch-execution.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql16": "playwright test --project=demo-gql16 e2e/demo-gql-workflow-integration.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql17": "playwright test --project=demo-gql17 e2e/demo-gql-workflow-runner.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql18": "playwright test --project=demo-gql18 e2e/demo-gql-workflow-mutation.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql19": "playwright test --project=demo-gql19 e2e/demo-gql-workflow-subscription.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql110": "playwright test --project=demo-gql110 e2e/demo-gql-workspace-isolation.spec.ts --reporter=html --workers=1",
    "test:e2e:demo:gql-smoke": "playwright test --project=demo-gql-lessons e2e/graphql-lessons.spec.ts --reporter=html --workers=1",
    "test:e2e:all": "E2E_WITH_DOCKER=1 playwright test",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@dagrejs/dagre": "^3.0.0",
    "@graphql-tools/mock": "^9.1.7",
    "@graphql-tools/schema": "^10.0.33",
    "@kafkajs/confluent-schema-registry": "^4.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-http": "^2.5.8",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@types/ws": "^8.18.1",
    "@xyflow/react": "^12.10.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.9.0",
    "busboy": "^1.6.0",
    "commander": "^14.0.3",
    "express": "^4.21.2",
    "extract-files": "^13.0.0",
    "graphql": "^17.0.1",
    "graphql-sse": "^2.6.0",
    "graphql-ws": "^6.0.8",
    "html-to-image": "^1.11.11",
    "json-diff-kit": "^1.0.35",
    "jsondiffpatch": "^0.7.3",
    "kafkajs": "^2.2.4",
    "kafkajs-snappy": "^1.1.0",
    "lz-string": "^1.5.0",
    "meros": "^1.3.2",
    "monaco-graphql": "^1.8.0",
    "node-cron": "^3.0.3",
    "papaparse": "^5.5.3",
    "pg": "^8.20.0",
    "prettier": "^3.8.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "uuid": "^13.0.0",
    "ws": "^8.21.0",
    "xlsx-js-style": "^1.2.0",
    "yaml": "^2.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.12.2",
    "@types/node-cron": "^3.0.11",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@zumer/snapdom": "^2.12.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "monaco-editor": "^0.52.2",
    "playwright": "^1.59.1",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
