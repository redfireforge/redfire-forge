# Environment variables template
# Copy this file to .env.development for local dev, or .env.production for production builds.
# Do NOT commit actual .env.* files — they are gitignored.

# Feature flags
VITE_ENABLE_DEMO_HUB=false          # true = Learning Hub build, false = standard build
VITE_ENABLE_GRPC_PROTO_HYBRID_EDITOR=true
