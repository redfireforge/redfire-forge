          },
          {
            "id": "sample-ambiguity-test",
            "name": "Cross-route ambiguity test",
            "request": {
              "method": "GET",
              "path": "/api/v1/users",
              "rawPath": "/api/v1/users",
              "query": {},
              "headers": {},
              "cookies": {},
              "body": null,
              "bodyTruncated": false,
              "receivedAt": "2026-08-11T00:00:00.000Z"
            },
