  },
  "data": {
    "scope": "servers",
    "servers": [
      {
        "id": "srv-users-001",
        "name": "Users API",
        "enabled": true,
        "host": "127.0.0.1",
        "port": 4600,
        "basePath": "/api/v1",
        "folders": [
          {
            "id": "folder-users",
            "name": "Users",
            "expanded": true,
            "sortOrder": 0
          },
          {
            "id": "folder-errors",
            "parentId": "folder-users",
            "name": "Error Responses",
            "expanded": false,
            "sortOrder": 1
          }
        ],
        "routes": [
          {
            "id": "route-get-users",
            "folderId": "folder-users",
            "name": "List Users",
            "enabled": true,
            "method": "GET",
            "path": {
              "kind": "exact",
              "value": "/users"
            },
            "priority": 10,
            "predicates": {
              "id": "pg-root-1",
              "combinator": "all",
              "children": []
            },
            "responseMode": "rules",
            "responses": [
              {
                "id": "resp-200-list",
                "name": "200 Default",
                "enabled": true,
                "isDefault": true,
                "status": 200,
                "headers": [
                  { "id": "h1", "key": "Content-Type", "value": "application/json", "enabled": true }
                ],
                "cookies": [],
                "body": {
                  "kind": "json",
                  "content": "{\"users\":[{\"id\":1,\"name\":\"Alice\"},{\"id\":2,\"name\":\"Bob\"}]}",
                  "contentType": "application/json"
                },
                "behavior": {
                  "delayMs": 0,
                  "jitterMs": 0
                }
              }
            ],
            "tags": ["users"],
            "createdAt": "2026-08-11T00:00:00.000Z",
            "updatedAt": "2026-08-11T00:00:00.000Z"
          },
          {
            "id": "route-get-user-by-id",
            "folderId": "folder-users",
            "name": "Get User by ID",
            "enabled": true,
            "method": "GET",
            "path": {
              "kind": "parameterized",
              "value": "/users/:id",
              "paramNames": ["id"]
            },
            "priority": 20,
            "predicates": {
              "id": "pg-root-2",
              "combinator": "all",
              "children": [
                {
                  "id": "pred-id-numeric",
                  "source": "pathParam",
                  "selector": "id",
                  "operator": "regex",
                  "expected": "^[0-9]+$",
                  "options": { "caseSensitive": true }
                }
              ]
            },
            "responseMode": "rules",
            "responses": [
              {
                "id": "resp-200-user",
                "name": "200 Default",
                "enabled": true,
                "isDefault": true,
                "status": 200,
                "headers": [
                  { "id": "h2", "key": "Content-Type", "value": "application/json", "enabled": true }
                ],
                "cookies": [],
                "body": {
                  "kind": "json",
                  "content": "{\"id\":\"{{pathParam 'id'}}\",\"name\":\"User {{pathParam 'id'}}\"}",
                  "contentType": "application/json"
                },
                "behavior": {
                  "delayMs": 50,
                  "jitterMs": 10
                }
              },
              {
                "id": "resp-404-user",
                "name": "404 Not Found",
                "enabled": true,
                "isDefault": false,
                "conditions": {
                  "id": "cond-404",
                  "combinator": "all",
                  "children": [
                    {
                      "id": "pred-id-99999",
                      "source": "pathParam",
                      "selector": "id",
                      "operator": "exact",
                      "expected": "99999"
                    }
                  ]
                },
                "status": 404,
                "headers": [
                  { "id": "h3", "key": "Content-Type", "value": "application/json", "enabled": true }
                ],
                "cookies": [],
                "body": {
                  "kind": "json",
                  "content": "{\"error\":\"not_found\"}",
                  "contentType": "application/json"
                },
                "behavior": {
                  "delayMs": 0,
                  "jitterMs": 0
                }
              }
            ],
            "tags": ["users"],
            "operationId": "getUserById",
            "createdAt": "2026-08-11T00:00:00.000Z",
            "updatedAt": "2026-08-11T00:00:00.000Z"
          },
          {
            "id": "route-post-user",
            "folderId": "folder-users",
            "name": "Create User",
            "enabled": true,
            "method": "POST",
            "path": {
              "kind": "exact",
              "value": "/users"
            },
            "priority": 10,
            "predicates": {
              "id": "pg-root-3",
              "combinator": "all",
              "children": [
                {
                  "id": "pred-json-body",
                  "source": "body",
                  "operator": "json_subset",
                  "expected": { "name": "string" },
                  "options": { "matchStyle": "subset" }
                }
              ]
            },
            "responseMode": "rules",
            "responses": [
              {
                "id": "resp-201-created",
                "name": "201 Default",
                "enabled": true,
                "isDefault": true,
                "status": 201,
                "headers": [
                  { "id": "h4", "key": "Content-Type", "value": "application/json", "enabled": true },
                  { "id": "h5", "key": "Location", "value": "/api/v1/users/{{uuid}}", "enabled": true }
                ],
                "cookies": [
                  {
                    "id": "cookie-session",
                    "name": "session",
                    "value": "{{uuid}}",
                    "enabled": true,
                    "path": "/",
                    "httpOnly": true,
                    "sameSite": "Strict"
                  }
                ],
                "body": {
                  "kind": "json",
                  "content": "{\"id\":\"{{uuid}}\",\"name\":\"{{jsonPath '$.name'}}\",\"created\":true}",
                  "contentType": "application/json"
                },
                "behavior": {
                  "delayMs": 100,
                  "jitterMs": 20
                }
              }
            ],
            "tags": ["users", "write"],
            "createdAt": "2026-08-11T00:00:00.000Z",
            "updatedAt": "2026-08-11T00:00:00.000Z"
          }
        ],
        "samples": [
          {
            "id": "sample-get-user-42",
            "name": "Get user 42",
            "routeId": "route-get-user-by-id",
            "request": {
              "method": "GET",
              "path": "/api/v1/users/42",
              "rawPath": "/api/v1/users/42",
              "query": {},
              "headers": { "accept": ["application/json"] },
              "cookies": {},
              "body": null,
              "bodyTruncated": false,
              "receivedAt": "2026-08-11T00:00:00.000Z"
            },
            "expected": {
              "outcome": "matched",
              "routeId": "route-get-user-by-id",
