{
  "id": "kafka-runner-load-policy-info",
  "name": "Runner — Load Policy Info",
  "description": "Workflow with kafkaConsume that has NO loadTestBehavior set. Should show INFO auto-resume banner in Workflow Runner.",
  "variables": {
    "testTopic": "runner.load.test"
  },
  "nodes": [
    {
      "id": "start-1",
      "type": "start",
      "position": { "x": 100, "y": 200 },
      "data": { "label": "Start" }
    },
    {
      "id": "produce-1",
      "type": "kafkaProduce",
      "position": { "x": 350, "y": 200 },
      "data": {
        "label": "Produce Event",
        "clusterId": "local-plaintext",
        "topic": "{{testTopic}}",
        "keyTemplate": "info-test-key",
        "bodyTemplate": "{\"type\":\"info-test\",\"ts\":\"{{$timestamp}}\"}",
        "headers": [
          { "id": "h1", "key": "Content-Type", "value": "application/json", "enabled": true }
        ],
        "ackMode": "leader",
        "timeoutMs": 5000
      }
    },
    {
      "id": "consume-info",
