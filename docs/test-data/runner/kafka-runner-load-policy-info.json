        "clusterId": "local-plaintext",
        "topic": "{{testTopic}}",
        "timeoutMs": 5000,
        "maxMessages": 1,
        "startPosition": "earliest"
      }
    },
    {
      "id": "end-1",
      "type": "end",
      "position": { "x": 900, "y": 200 },
      "data": { "label": "End" }
    }
  ],
  "edges": [
    { "id": "e-start-produce", "source": "start-1", "target": "produce-1" },
    { "id": "e-produce-consume", "source": "produce-1", "target": "consume-info" },
    { "id": "e-consume-end", "source": "consume-info", "target": "end-1" }
  ],
