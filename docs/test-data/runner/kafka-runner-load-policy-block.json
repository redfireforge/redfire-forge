{
  "id": "kafka-runner-load-policy-block",
  "name": "Runner — Load Policy Block",
  "description": "Workflow with kafkaConsume in wait-for-real mode. Should show BLOCK banner in Workflow Runner and prevent load test execution.",
  "variables": {
    "testTopic": "runner.load.test"
  },
  "nodes": [
    {
      "id": "start-1",
      "type": "start",
      "position": { "x": 100, "y": 200 },
      "data": { "label": "Start" }
    },
    {
      "id": "produce-1",
      "type": "kafkaProduce",
      "position": { "x": 350, "y": 200 },
      "data": {
        "label": "Produce Event",
        "clusterId": "local-plaintext",
        "topic": "{{testTopic}}",
        "keyTemplate": "load-test-key",
        "bodyTemplate": "{\"type\":\"load-test\",\"ts\":\"{{$timestamp}}\"}",
        "headers": [
          { "id": "h1", "key": "Content-Type", "value": "application/json", "enabled": true }
        ],
        "ackMode": "leader",
        "timeoutMs": 5000
      }
    },
    {
      "id": "consume-block",
      "type": "kafkaConsume",
      "position": { "x": 650, "y": 200 },
      "data": {
        "label": "Consume (wait-for-real)",
        "clusterId": "local-plaintext",
        "topic": "{{testTopic}}",
        "timeoutMs": 5000,
        "maxMessages": 1,
        "startPosition": "earliest",
        "loadTestBehavior": {
          "mode": "wait-for-real"
        }
      }
    },
    {
      "id": "end-1",
      "type": "end",
      "position": { "x": 900, "y": 200 },
      "data": { "label": "End" }
    }
  ],
  "edges": [
    { "id": "e-start-produce", "source": "start-1", "target": "produce-1" },
    { "id": "e-produce-consume", "source": "produce-1", "target": "consume-block" },
    { "id": "e-consume-end", "source": "consume-block", "target": "end-1" }
  ],
  "schemaVersion": 11,
  "createdAt": 1749200000000,
  "updatedAt": 1749200000000
}
