{
  "name": "JSON Format Example",
  "baseUrl": "https://httpbin.org",
  "defaults": {
    "headers": {
      "Accept": "application/json"
    },
    "timeout": 10
  },
  "config": {
    "concurrency": 2,
    "transactions": 6,
    "mode": "batch"
  },
  "tests": [
    {
      "name": "List Users",
      "url": "/get?type=users",
      "method": "GET"
    },
    {
      "name": "Get User by ID",
      "url": "/get?userId=1",
      "method": "GET",
      "validation": {
        "mode": "selective",
        "expectedFields": [
          { "jsonPath": "$.args.userId", "expectedValue": "1" }
        ]
      }
    },
    {
      "name": "Create Post",
      "url": "/post",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"title\": \"Test\", \"body\": \"Created by RedfireForge\", \"userId\": 1}",
      "weight": 2
    }
  ]
}
