{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RedfireForge Learning Hub",
  "version": "0.6.0",
  "identifier": "com.redfireforge.desktop.demo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:demo",
    "beforeBuildCommand": "npm run build:demo"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RedfireForge Learning Hub — Redfire Performance Workbench",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../cli/dist/redfireforge.mjs"
    ],
    "macOS": {
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/redfireforge/postinstall.sh": "installer/linux/postinstall.sh",
          "/usr/lib/redfireforge/preremove.sh": "installer/linux/preremove.sh"
        }
      }
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "shortcutName": "RedfireForge Learning Hub"
      },
      "wix": {
        "template": "installer/windows/main.wxs"
      }
    }
  }
}
